# Optional. Improves GitHub rate limits and enables private repository access.
GITHUB_TOKEN=

# Optional. When all three are set, changed-file diffs and bounded source snippets
# are sent to this OpenAI-compatible chat completions endpoint to generate PR workflows.
# Set WALKTHROUGH_API_URL to the full endpoint URL, including /v1/chat/completions.
WALKTHROUGH_API_KEY=
WALKTHROUGH_API_URL=https://api.openai.com/v1/chat/completions
WALKTHROUGH_MODEL=

# Optional. Directory for the SQLite database (trace.db). Default: .trace/ in the repository.
TRACE_DATA_DIR=

# Optional. Base URL of this app; the MCP tools return a link to the analysis built from it.
# TRACE_APP_URL=http://localhost:5173
